FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-pyqt5 \
    python3-matplotlib \
    xvfb \
    fluxbox \
    x11vnc \
    novnc \
    websockify \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

EXPOSE 6080

CMD ["/app/docker/entrypoint-client.sh"]
