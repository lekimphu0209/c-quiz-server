FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    make \
    libsqlite3-dev \
    sqlite3 \
    valgrind \
    gdb \
    curl \
    python3 \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PORT=5000
ENV DB_PATH=/data/exam.db

VOLUME ["/data"]

EXPOSE 5000

CMD ["/app/docker/entrypoint-server.sh"]
